generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  pursuits      Pursuit[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Subscription {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  stripeCustomerId         String    @unique
  stripeSubscriptionId     String?   @unique
  stripePriceId            String?
  stripeCurrentPeriodEnd   DateTime?
  status                   String    @default("trialing")
  trialEnd                 DateTime?
  selectedNiches           String[]  @default([])
  nicheLockedUntil         DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bid {
  id                 String    @id @default(cuid())
  noticeId           String    @unique
  title              String
  solicitationNumber String?
  agency             String?
  naicsCode          String?
  niche              String
  postedDate         DateTime?
  responseDeadline   DateTime?
  setAside           String?
  bidType            String?
  uiLink             String?
  placeStreet        String?
  placeCity          String?
  placeState         String?
  placeZip           String?
  placeCountry       String?
  active             Boolean   @default(true)
  syncedAt           DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  pursuits           Pursuit[]

  @@index([niche])
  @@index([postedDate])
  @@index([responseDeadline])
  @@index([active])
  @@index([placeCity, placeState])
}

model Pursuit {
  id                             String              @id @default(cuid())
  userId                         String
  bidId                          String
  decision                       String              @default("WATCH")
  stage                          String              @default("REVIEWING")
  priority                       String              @default("NORMAL")
  notes                          String?
  nextAction                     String?
  supplierScope                  String?
  scopeReviewed                  Boolean             @default(false)
  complianceReviewed             Boolean             @default(false)
  submissionInstructionsReviewed Boolean             @default(false)
  amendmentsChecked              Boolean             @default(false)
  questionDeadline               DateTime?
  supplierQuoteDeadline          DateTime?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  user                           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bid                            Bid                 @relation(fields: [bidId], references: [id], onDelete: Cascade)
  suppliers                      SupplierCandidate[]
  estimate                       PursuitEstimate?
  quotes                         QuoteDraft[]

  @@unique([userId, bidId])
  @@index([userId, decision])
  @@index([userId, stage])
  @@index([supplierQuoteDeadline])
}

model SupplierCandidate {
  id            String   @id @default(cuid())
  pursuitId     String
  name          String
  address       String?
  city          String?
  state         String?
  phone         String?
  email         String?
  website       String?
  source        String   @default("local-search")
  sourceId      String?
  distanceMiles Float?
  status        String   @default("NEW")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pursuit       Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)

  @@unique([pursuitId, name, address])
  @@index([pursuitId, status])
}

model PursuitEstimate {
  id               String   @id @default(cuid())
  pursuitId        String   @unique
  supplierCost     Float    @default(0)
  freightCost      Float    @default(0)
  laborCost        Float    @default(0)
  financingCost    Float    @default(0)
  contingencyCost  Float    @default(0)
  otherCost        Float    @default(0)
  targetMarginPct  Float    @default(20)
  recommendedPrice Float    @default(0)
  internalNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  pursuit          Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
}

model QuoteDraft {
  id              String   @id @default(cuid())
  pursuitId       String
  version         Int      @default(1)
  status          String   @default("DRAFT")
  title           String
  scopeText       String
  assumptionsText String?
  deliveryText    String?
  validityDays    Int      @default(30)
  totalPrice      Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pursuit         Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)

  @@unique([pursuitId, version])
  @@index([pursuitId, status])
}
