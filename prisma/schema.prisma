generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  sessions               Session[]
  subscription           Subscription?
  pursuits               Pursuit[]
  notificationPreference NotificationPreference?
  customCategories       CustomCategory[]
  notificationDeliveries NotificationDelivery[]
  companyProfile         CompanyProfile?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  stripeCustomerId       String    @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  status                 String    @default("trialing")
  trialEnd               DateTime?
  selectedNiches         String[]  @default([])
  nicheLockedUntil       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  legalName     String
  dbaName       String?
  uei           String?
  cageCode      String?
  address1      String?
  address2      String?
  city          String?
  state         String?
  zip           String?
  country       String   @default("USA")
  phone         String?
  quoteEmail    String?
  website       String?
  contactName   String?
  remitTo       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bid {
  id                     String                 @id @default(cuid())
  noticeId               String                 @unique
  title                  String
  solicitationNumber     String?
  agency                 String?
  naicsCode              String?
  classificationCode     String?
  niche                  String
  postedDate             DateTime?
  sourceModifiedAt       DateTime?
  responseDeadline       DateTime?
  setAside               String?
  bidType                String?
  baseType               String?
  uiLink                 String?
  placeStreet            String?
  placeCity              String?
  placeState             String?
  placeZip               String?
  placeCountry           String?
  active                 Boolean                @default(true)
  syncedAt               DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  pursuits               Pursuit[]
  notificationDeliveries NotificationDelivery[]
  changes                BidChange[]

  @@index([niche])
  @@index([postedDate])
  @@index([sourceModifiedAt])
  @@index([responseDeadline])
  @@index([active])
  @@index([placeCity, placeState])
}

model BidChange {
  id         String   @id @default(cuid())
  bidId      String
  changeType String
  field      String
  oldValue   String?
  newValue   String?
  detectedAt DateTime @default(now())
  bid        Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId, detectedAt])
  @@index([changeType, detectedAt])
  @@index([field, detectedAt])
}

model Pursuit {
  id                             String              @id @default(cuid())
  userId                         String
  bidId                          String
  decision                       String              @default("WATCH")
  stage                          String              @default("REVIEWING")
  priority                       String              @default("NORMAL")
  notes                          String?
  nextAction                     String?
  supplierScope                  String?
  scopeReviewed                  Boolean             @default(false)
  complianceReviewed             Boolean             @default(false)
  submissionInstructionsReviewed Boolean             @default(false)
  amendmentsChecked              Boolean             @default(false)
  questionDeadline               DateTime?
  supplierQuoteDeadline          DateTime?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  user                           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bid                            Bid                 @relation(fields: [bidId], references: [id], onDelete: Cascade)
  suppliers                      SupplierCandidate[]
  estimate                       PursuitEstimate?
  quotes                         QuoteDraft[]

  @@unique([userId, bidId])
  @@index([userId, decision])
  @@index([userId, stage])
  @@index([supplierQuoteDeadline])
}

model SupplierCandidate {
  id            String   @id @default(cuid())
  pursuitId     String
  name          String
  address       String?
  city          String?
  state         String?
  phone         String?
  email         String?
  website       String?
  source        String   @default("local-search")
  sourceId      String?
  distanceMiles Float?
  status        String   @default("NEW")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pursuit       Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)

  @@unique([pursuitId, name, address])
  @@index([pursuitId, status])
}

model PursuitEstimate {
  id               String   @id @default(cuid())
  pursuitId        String   @unique
  supplierCost     Float    @default(0)
  freightCost      Float    @default(0)
  laborCost        Float    @default(0)
  financingCost    Float    @default(0)
  contingencyCost  Float    @default(0)
  otherCost        Float    @default(0)
  targetMarginPct  Float    @default(20)
  recommendedPrice Float    @default(0)
  internalNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  pursuit          Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
}

model QuoteDraft {
  id              String   @id @default(cuid())
  pursuitId       String
  version         Int      @default(1)
  status          String   @default("DRAFT")
  title           String
  scopeText       String
  assumptionsText String?
  deliveryText    String?
  validityDays    Int      @default(30)
  totalPrice      Float
  companySnapshot Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pursuit         Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)

  @@unique([pursuitId, version])
  @@index([pursuitId, status])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNewPosts      Boolean  @default(true)
  emailDeadlines     Boolean  @default(true)
  smsNewPosts        Boolean  @default(false)
  smsDeadlines       Boolean  @default(false)
  phone              String?
  smsConsentAt       DateTime?
  deadlineHours      Int[]    @default([168, 72, 24])
  timezone           String   @default("UTC")
  lastNewPostCheckAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomCategory {
  id               String   @id @default(cuid())
  userId           String
  name             String
  keywords         String[] @default([])
  excludedKeywords String[] @default([])
  naicsCodes       String[] @default([])
  states           String[] @default([])
  agencies         String[] @default([])
  setAsides        String[] @default([])
  active           Boolean  @default(true)
  emailAlerts      Boolean  @default(true)
  smsAlerts        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model NotificationDelivery {
  id         String   @id @default(cuid())
  userId     String
  bidId      String
  kind       String
  channel    String
  triggerKey String
  sentAt     DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bid        Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@unique([userId, bidId, kind, channel, triggerKey])
  @@index([userId, sentAt])
}
